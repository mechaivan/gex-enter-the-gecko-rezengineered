; fakereal_full.def — exports of the fake real DLL (Win32 harness only).
; The 3 stdcall names MUST match what gshim.c resolves
; ("_grBufferSwap@4" etc.); fakereal_counts is the harness-only
; interrogation export. F-3 H4a form (like gshim.def): mismatch-alias
; "decorated"=internal, NO dllexport in fakereal.c (dllexport would
; emit underscore-less twins). Missing-one-export variants are
; generated by build-harness.sh (this file minus one line each), so
; GetProcAddress then fails exactly like a real DLL lacking that
; symbol. Variant export sets are byte-verified before any run.
LIBRARY glide2x_gex_real
EXPORTS
    "_grBufferSwap@4"=grBufferSwap@4
    "_grBufferNumPending@0"=grBufferNumPending@0
    "_grGlideShutdown@0"=grGlideShutdown@0
    "_fakereal_counts@16"=fakereal_counts@16
